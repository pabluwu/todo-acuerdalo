# --- Base de datos ---
DB_HOST=db
DB_PORT=5432
DB_USER=acuerdalo
DB_PASSWORD=acuerdalo
DB_NAME=acuerdalo

# --- Autenticación ---
# Cambia este valor en producción (openssl rand -hex 32)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=7d
# Pon true si sirves la app por HTTPS
COOKIE_SECURE=false

# --- App ---
# URL pública del frontend (se usa en los enlaces de los correos)
APP_URL=http://localhost:3000
# Adjuntos
UPLOAD_MAX_MB=10

# --- Almacenamiento de archivos ---
# local = disco del contenedor (UPLOAD_DIR); r2 = Cloudflare R2
STORAGE_DRIVER=local
# Cloudflare R2: R2 > Manage API tokens > token "Object Read & Write" limitado al bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=acuerdalo-uploads
# Opcional: si se deja vacío se usa https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# --- Correo (por defecto mailpit, UI en http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Acuérdalo <no-reply@acuerdalo.local>"

# --- Alertas de vencimiento (expresión cron; por defecto cada hora) ---
DUE_ALERT_CRON=0 * * * *

# --- Resumen semanal por correo (expresión cron, en APP_TIMEZONE; por defecto lunes 09:00) ---
WEEKLY_SUMMARY_CRON=0 9 * * 1

# --- Calendario ---
# Zona horaria usada para formatear fechas y horas en los correos del calendario
APP_TIMEZONE=America/Santiago

# --- Notificaciones push (Web Push / VAPID) ---
# Generar una sola vez con: npx web-push generate-vapid-keys
# Sin estas llaves el push queda desactivado (el correo sigue funcionando)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@acuerdalo.cl
