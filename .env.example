# --- Base de datos ---
DB_HOST=db
DB_PORT=5432
DB_USER=acuerdalo
DB_PASSWORD=acuerdalo
DB_NAME=acuerdalo

# --- Autenticación ---
# Cambia este valor en producción (openssl rand -hex 32)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=7d
# Pon true si sirves la app por HTTPS
COOKIE_SECURE=false

# --- App ---
# URL pública del frontend (se usa en los enlaces de los correos)
APP_URL=http://localhost:3000
# Adjuntos
UPLOAD_MAX_MB=10

# --- Correo (por defecto mailpit, UI en http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Acuérdalo <no-reply@acuerdalo.local>"

# --- Alertas de vencimiento (expresión cron; por defecto cada hora) ---
DUE_ALERT_CRON=0 * * * *

# --- Resumen semanal por correo (expresión cron, en APP_TIMEZONE; por defecto lunes 09:00) ---
WEEKLY_SUMMARY_CRON=0 9 * * 1

# --- Calendario ---
# Zona horaria usada para formatear fechas y horas en los correos del calendario
APP_TIMEZONE=America/Santiago
